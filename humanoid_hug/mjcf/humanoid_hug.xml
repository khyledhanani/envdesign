    <motor name="h0_right_ankle" joint="h0_right_ankle" gear="100" ctrlrange="-1 1"/>
    <motor name="h0_left_shoulder1" joint="h0_left_shoulder1" gear="25" ctrlrange="-1 1"/>
    <motor name="h0_left_shoulder2" joint="h0_left_shoulder2" gear="25" ctrlrange="-1 1"/>
    <motor name="h0_left_elbow" joint="h0_left_elbow" gear="25" ctrlrange="-1 1"/>
    <motor name="h0_right_shoulder1" joint="h0_right_shoulder1" gear="25" ctrlrange="-1 1"/>
    <motor name="h0_right_shoulder2" joint="h0_right_shoulder2" gear="25" ctrlrange="-1 1"/>
    <motor name="h0_right_elbow" joint="h0_right_elbow" gear="25" ctrlrange="-1 1"/>

    <!-- Humanoid 1 actuators (21 total) -->
    <motor name="h1_abdomen_z" joint="h1_abdomen_z" gear="100" ctrlrange="-1 1"/>
    <motor name="h1_abdomen_y" joint="h1_abdomen_y" gear="100" ctrlrange="-1 1"/>
