    <motor name="h1_left_ankle" joint="h1_left_ankle" gear="100" ctrlrange="-1 1"/>
    <motor name="h1_right_hip_x" joint="h1_right_hip_x" gear="100" ctrlrange="-1 1"/>
    <motor name="h1_right_hip_z" joint="h1_right_hip_z" gear="100" ctrlrange="-1 1"/>
    <motor name="h1_right_hip_y" joint="h1_right_hip_y" gear="100" ctrlrange="-1 1"/>
    <motor name="h1_right_knee" joint="h1_right_knee" gear="100" ctrlrange="-1 1"/>
    <motor name="h1_right_ankle" joint="h1_right_ankle" gear="100" ctrlrange="-1 1"/>
    <motor name="h1_left_shoulder1" joint="h1_left_shoulder1" gear="25" ctrlrange="-1 1"/>
    <motor name="h1_left_shoulder2" joint="h1_left_shoulder2" gear="25" ctrlrange="-1 1"/>
    <motor name="h1_left_elbow" joint="h1_left_elbow" gear="25" ctrlrange="-1 1"/>
    <motor name="h1_right_shoulder1" joint="h1_right_shoulder1" gear="25" ctrlrange="-1 1"/>
    <motor name="h1_right_shoulder2" joint="h1_right_shoulder2" gear="25" ctrlrange="-1 1"/>
    <motor name="h1_right_elbow" joint="h1_right_elbow" gear="25" ctrlrange="-1 1"/>
  </actuator>
